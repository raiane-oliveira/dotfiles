/**
 * Rofi Theme — Package Manager
 * Baseado no tema estilo-5 do usuário (adi1090x)
 * Adaptado para uso como gerenciador de pacotes (dmenu mode)
 **/

/*****----- Configuration -----*****/
configuration {
    show-icons:             false;

    /* Navegação estilo Vim */
    kb-row-up: "Up,Control+k,Shift+Tab,Shift+ISO_Left_Tab";
    kb-row-down: "Down,Control+j";
    kb-accept-entry: "Control+m,Return,KP_Enter";

    kb-mode-complete: "";
    /* Opcional: Navegação entre modos/histórico */
    kb-mode-previous: "Shift+Left,Control+h";
    kb-mode-next: "Shift+Right,Control+l";

    /* Opcional: Remover caracteres */
    kb-remove-to-eol: "Control+Shift+e";
    kb-remove-char-back: "BackSpace";
}

/*****----- Global Properties -----*****/
* {
    font:                        "Adwaita Sans 11";
    background:                  #231419;
    background-alt:              #2D1E23;
    foreground:                  #FFFFFF;
    selected:                    #426647;
    active:                      #2E3F34;
    urgent:                      #D08261;
    accent:                      #5A8C60;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1000px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               15px;
    cursor:                      "default";
    background-color:            @background;
    border:                      2px solid;
    border-color:                @active;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     14px 18px;
    border-radius:               15px 15px 0px 0px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}

textbox-prompt-colon {
    font:                       "JetBrainsMono Nerd Font Propo 13";
    enabled:                     true;
    expand:                      false;
    str:                         "󰊠";
    padding:                     0px 8px 0px 0px;
    background-color:            inherit;
    text-color:                  @accent;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Buscar pacote…";
    placeholder-color:           #888888;
}

num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  #888888;
    font:                        "Adwaita Sans 9";
}

textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    background-color:            inherit;
    text-color:                  #888888;
    font:                        "Adwaita Sans 9";
}

num-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  #888888;
    font:                        "Adwaita Sans 9";
}

/*****----- Message (dica de atalhos) -----*****/
message {
    enabled:                     true;
    padding:                     8px 18px;
    background-color:            @active;
    text-color:                  @foreground;
}


textbox {
    font:                        "Adwaita Sans 10";
    background-color:            transparent;
    text-color:                  #AAAAAA;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    padding:                     0px;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     4px;
    padding:                     10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
    children:                    [ "message" ];
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     12px;
    padding:                     8px 12px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element normal.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}

element normal.active {
    background-color:            @active;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @foreground;
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}

element selected.active {
    background-color:            @urgent;
    text-color:                  @foreground;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Error -----*****/
error-message {
    padding:                     15px;
    border-radius:               15px;
    background-color:            @background;
    text-color:                  @urgent;
}
